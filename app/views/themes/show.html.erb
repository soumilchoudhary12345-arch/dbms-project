<% content_for(:title, "Atmospheres & Themes") %>

<div data-controller="theme" class="mx-auto max-w-4xl pb-16">
  <!-- Header with artistic intro and computer sync switch -->
  <header class="mb-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-end border-b border-slate-200 pb-8">
    <div>
      <div class="flex items-center gap-2 mb-2 text-xs font-semibold uppercase tracking-widest text-indigo-600">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-indigo-600"></span>
        Environment & Atmosphere
      </div>
      <h1 class="text-3xl font-serif tracking-tight text-slate-900 sm:text-4xl">Study Spaces</h1>
      <p class="mt-2 text-sm text-slate-600 max-w-xl leading-relaxed">
        Curated atmospheric bindings pairing specialized paper textures, tactile typography, and tailored ink pigments. Select an edition, then tune your color binding below.
      </p>
    </div>

    <!-- Sync Toggle Card -->
    <div class="flex shrink-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-xs">
      <div class="flex flex-col">
        <span class="text-xs font-semibold text-slate-800">Auto-Sync</span>
        <span class="text-[11px] text-slate-500">Match system OS</span>
      </div>
      <button type="button"
              role="switch"
              aria-checked="true"
              aria-label="Sync theme to computer"
              data-action="theme#toggleSync"
              data-theme-target="switch"
              class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-slate-200 transition-colors duration-200 ease-in-out focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
        <span data-theme-target="knob" class="sync-knob pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out"></span>
      </button>
    </div>
  </header>

  <!-- Curated Atmosphere Collection Cards (Unified Reduced Interface) -->
  <div class="grid gap-6 sm:grid-cols-2">
    <% theme_collections.each do |collection| %>
      <section class="theme-collection-card group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-xs transition-all duration-200 hover:shadow-md hover:border-slate-300"
               data-theme-target="collection"
               data-collection-id="<%= collection[:id] %>"
               data-variants="<%= collection[:variants].map { |v| v[:id] }.join(',') %>">
        
        <div>
          <!-- Card Header & Badge -->
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-700 transition-colors group-hover:bg-indigo-50 group-hover:text-indigo-600">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <%= collection[:icon].html_safe %>
                </svg>
              </span>
              <div>
                <h2 class="text-xl font-serif text-slate-900"><%= collection[:name] %></h2>
                <span class="text-[11px] font-mono tracking-wide text-slate-400 uppercase"><%= collection[:variants].size %> Inks</span>
              </div>
            </div>
            
            <span data-theme-target="badge" class="hidden items-center gap-1 rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700 border border-indigo-200">
              <span class="h-1.5 w-1.5 rounded-full bg-indigo-600"></span> Active
            </span>
          </div>

          <p class="text-xs text-slate-600 mb-6 leading-relaxed">
            <%= collection[:tagline] %>
          </p>
        </div>

        <!-- Color Bindings & Sub-palette Selector -->
        <div class="mt-auto border-t border-slate-100 pt-4">
          <div class="mb-2.5 flex items-center justify-between">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Color Binding</span>
            <span data-theme-target="activeVariantLabel" class="text-xs font-medium text-slate-700"></span>
          </div>

          <div class="grid grid-cols-<%= collection[:variants].size > 2 ? '2' : collection[:variants].size %> gap-2 sm:grid-cols-2">
            <% collection[:variants].each do |variant| %>
              <button type="button"
                      data-action="theme#select"
                      data-preset="<%= variant[:id] %>"
                      data-collection="<%= collection[:id] %>"
                      data-name="<%= variant[:name] %>"
                      data-desc="<%= variant[:desc] %>"
                      data-theme-target="option"
                      class="relative flex items-center justify-between gap-2.5 rounded-xl border border-slate-200 bg-slate-50/60 p-2.5 text-left transition-all hover:bg-slate-100 hover:border-slate-300 focus:outline-hidden">
                <div class="min-w-0 flex-1">
                  <span class="block truncate text-xs font-semibold text-slate-800"><%= variant[:name] %></span>
                  <span class="block truncate text-[10px] text-slate-500"><%= variant[:desc] %></span>
                </div>

                <!-- Color Swatch Chips -->
                <div class="flex shrink-0 items-center -space-x-1 overflow-hidden p-0.5">
                  <% variant[:chips].each do |color| %>
                    <span class="h-4 w-4 rounded-full ring-1 ring-black/10 shadow-xs" style="background: <%= color %>"></span>
                  <% end %>
                </div>

                <!-- Checkmark on Active State -->
                <span data-check class="hidden absolute top-1.5 right-1.5 flex h-3.5 w-3.5 items-center justify-center rounded-full bg-indigo-600 text-[9px] font-bold text-white shadow-xs">
                  ✓
                </span>
              </button>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
