<% content_for(:title, @subject.name) %>

<%= link_to "&larr; All notes".html_safe, notes_path, class: "text-sm font-medium text-indigo-600 hover:underline" %>

<h1 class="mb-2 mt-3 text-2xl font-bold"><%= @subject.name %></h1>
<p class="mb-6 text-sm text-slate-500">Click a chapter to open it in a new tab.</p>

<h2 class="mb-3 text-lg font-semibold">Chapters</h2>

<div class="flex flex-col gap-2">
  <% (1..@chapter_count).each do |number| %>
    <% parts = @subject.chapters.select { |c| c.number == number } %>
    <% if parts.empty? %>
      <div class="flex h-12 items-stretch overflow-hidden rounded-lg border border-dashed border-slate-200 bg-slate-50/60">
        <span class="flex min-w-0 flex-1 items-center gap-3 px-4 font-medium text-slate-400">
          <span class="w-5 shrink-0 font-mono text-sm"><%= number %></span>
          <span class="truncate"><%= chapter_title(number) %></span>
        </span>
        <span class="flex items-center px-4 text-xs font-medium uppercase tracking-wide text-slate-400">Not available</span>
      </div>
    <% else %>
      <% parts.each do |chapter| %>
        <div class="flex h-12 items-stretch overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
          <%= link_to chapter_pdf_path(kind: "notes", subject: @subject.slug, number: chapter.number, part: chapter.part),
                target: "_blank", rel: "noopener",
                class: "flex min-w-0 flex-1 items-center gap-3 px-4 font-medium text-slate-800 hover:bg-slate-50" do %>
            <span class="w-5 shrink-0 font-mono text-sm text-indigo-600"><%= chapter.number %></span>
            <span class="truncate"><%= chapter.title %></span>
            <% if chapter.part > 1 %>
              <span class="shrink-0 text-xs font-normal text-slate-400">Part <%= chapter.part %></span>
            <% end %>
          <% end %>
          <%= link_to "Download",
                chapter_pdf_path(kind: "notes", subject: @subject.slug, number: chapter.number, part: chapter.part, download: 1),
                class: "flex items-center border-l border-slate-200 px-4 text-sm font-medium text-indigo-600 hover:bg-indigo-50",
                title: "Download #{chapter.filename}" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
