<% content_for(:title, @subject.name) %>

<%= link_to "&larr; All notes".html_safe, notes_path, class: "text-sm font-medium text-indigo-600 hover:underline" %>

<h1 class="mb-2 mt-3 text-2xl font-bold"><%= @subject.name %></h1>
<p class="mb-6 text-sm text-slate-500">Click a chapter to open it in a new tab.</p>

<div class="flex flex-col gap-2">
  <% @subject.chapters.each do |chapter| %>
    <div class="flex h-12 items-stretch overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      <%= link_to chapter_pdf_path(kind: "notes", subject: @subject.slug, number: chapter.number, part: chapter.part),
            target: "_blank", rel: "noopener",
            class: "flex flex-1 items-center px-4 font-medium text-slate-800 hover:bg-slate-50" do %>
        <%= chapter.label %>
      <% end %>
      <%= link_to "Download",
            chapter_pdf_path(kind: "notes", subject: @subject.slug, number: chapter.number, part: chapter.part, download: 1),
            class: "flex items-center border-l border-slate-200 px-4 text-sm font-medium text-indigo-600 hover:bg-indigo-50",
            title: "Download #{chapter.filename}" %>
    </div>
  <% end %>
</div>
