<% content_for(:title, "Mistake book") %>

<h1 class="mb-2 text-2xl font-bold">Mistake book</h1>
<p class="mb-6 text-sm text-slate-500">
  <% if @total_open > 0 %>
    <%= @total_open %> <%= "question".pluralize(@total_open) %> worth another pass. Retry until they stick.
  <% elsif @resolved_count > 0 %>
    Everything you missed has been marked understood.
  <% else %>
    Wrong and skipped answers from your practice sessions land here for a second pass.
  <% end %>
</p>

<% chip = "rounded-full border px-3 py-1.5 text-xs font-medium transition" %>
<% chip_on = "border-indigo-600 bg-indigo-600 text-white" %>
<% chip_off = "border-slate-200 text-slate-600 hover:bg-slate-50" %>
<div class="mb-6 flex flex-wrap items-center gap-2">
  <%= link_to "To review (#{@total_open})", mistakes_path,
        class: [chip, params[:view] == "resolved" || params[:topic].present? ? chip_off : chip_on] %>
  <% @topics.each do |topic| %>
    <%= link_to topic_name(topic), mistakes_path(topic: topic),
          class: [chip, params[:topic] == topic ? chip_on : chip_off] %>
  <% end %>
  <%= link_to "Understood (#{@resolved_count})", mistakes_path(view: "resolved"),
        class: [chip, params[:view] == "resolved" ? chip_on : chip_off] %>
</div>

<% if @attempts.empty? %>
  <p class="rounded-lg border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500">
    <% if @total_open.zero? && @resolved_count.zero? %>
      No mistakes recorded yet — anything you miss in a practice set will show up here.
      <%= link_to "Start a practice", questions_path, class: "text-indigo-600 hover:underline" %>.
    <% elsif params[:view] == "resolved" && @resolved_count.zero? %>
      Nothing marked as understood yet.
    <% else %>
      Nothing under this filter.
      <%= link_to "Clear", mistakes_path, class: "text-indigo-600 hover:underline" %>.
    <% end %>
  </p>
<% else %>
  <div class="flex flex-col gap-4">
    <% @attempts.each do |attempt| %>
      <% q = attempt.question %>
      <% times = @miss_counts[q.id].to_i %>
      <article class="rounded-lg border border-rose-300 bg-white p-5">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <span class="text-sm font-semibold text-rose-600">
            <%= attempt.skipped? ? "Skipped" : "Wrong" %><% if times > 1 %> · missed <%= times %> times<% end %>
          </span>
          <span class="text-xs text-slate-400">
            <% if q.topic.present? %><%= topic_name(q.topic) %> · <% end %><%= q.difficulty.humanize %> · missed <%= attempt.created_at.strftime("%b %d, %Y") %>
          </span>
        </div>

        <p class="mb-3 min-w-0 break-words whitespace-pre-line text-slate-800"><%= q.body %></p>

        <div class="mb-3 flex flex-col gap-1 text-sm">
          <% q.options_hash.sort.each do |letter, text| %>
            <div class="min-w-0 break-words <%= letter == q.answer ? 'font-semibold text-emerald-700' : (letter == attempt.answer ? 'text-rose-600' : 'text-slate-600') %>">
              <%= letter %>. <%= text %>
              <% if letter == q.answer %> <span class="text-xs">(correct answer)</span><% end %>
              <% if letter == attempt.answer && !attempt.correct %> <span class="text-xs">(your answer)</span><% end %>
            </div>
          <% end %>
        </div>

        <% if q.solution.present? %>
          <div class="rounded-md bg-slate-50 p-3 text-sm text-slate-700">
            <span class="font-semibold">Solution:</span> <%= q.solution %>
          </div>
        <% end %>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <%= button_to "Retry question", retry_question_path(q),
                method: :post, form: { class: "inline" },
                class: "cursor-pointer rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700" %>
          <% if attempt.resolved? %>
            <%= button_to "Put it back", reopen_mistake_path(q),
                  method: :post, form: { class: "inline" },
                  class: "cursor-pointer rounded-md border border-slate-200 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50" %>
            <span class="text-xs text-emerald-600">Marked understood <%= attempt.resolved_at.strftime("%b %d") %></span>
          <% else %>
            <%= button_to "Mark as understood", resolve_mistake_path(q),
                  method: :post, form: { class: "inline" },
                  class: "cursor-pointer rounded-md border border-slate-200 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50" %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
<% end %>
