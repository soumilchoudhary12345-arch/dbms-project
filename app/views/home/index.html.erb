<nav class="mt-10 border-t border-slate-200" aria-label="Study sections">
  <% [
    [notes_path,     "Notes",     "Chapter notes, in order, ready to open.", "#{@notes_chapters} chapters"],
    [books_path,     "Textbook",  "Every NCERT chapter as a PDF.",           "#{@book_chapters} chapters"],
    [questions_path, "Questions", "Timed practice sets, scored as you go.",  "#{@question_count} questions"],
    [mistakes_path,  "Mistakes", "Missed questions, ready to retry.",        @open_mistakes.zero? ? "all clear" : "#{@open_mistakes} to review"],
    [themes_path,    "Themes",    "Change how the page looks.",              "#{theme_presets.size} themes"]
  ].each do |path, name, desc, meta| %>
    <%= link_to path, class: "group flex items-center gap-4 border-b border-slate-200 px-2 py-4 hover:bg-slate-50" do %>
      <span class="min-w-0 flex-1">
        <span class="toc-title block"><%= name %></span>
        <span class="mt-0.5 block text-sm text-slate-500"><%= desc %></span>
      </span>
      <span class="shrink-0 text-sm text-slate-400"><%= meta %></span>
    <% end %>
  <% end %>
</nav>

<div class="mt-12 grid gap-8 sm:grid-cols-2">
  <section>
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="text-lg font-semibold">Checklist</h2>
      <% if @todos.any? %>
        <span class="text-sm text-slate-500"><%= @done_count %>/<%= @todos.size %> done</span>
      <% end %>
    </div>

    <%= form_with model: Todo.new, class: "mb-3 flex gap-2" do |f| %>
      <%= f.text_field :title,
            placeholder: "Add a task, e.g. Revise chapter 7",
            required: true, maxlength: 120,
            class: "min-w-0 flex-1 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm" %>
      <%= f.submit "Add",
            class: "cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
    <% end %>

    <% if @todos.empty? %>
      <p class="rounded-lg border border-dashed border-slate-200 px-4 py-6 text-center text-sm text-slate-500">
        Nothing on the list yet. Add what you'll finish today.
      </p>
    <% else %>
      <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
        <% @todos.each do |todo| %>
          <div class="flex items-center gap-3 border-b border-slate-100 px-4 py-2.5 last:border-b-0">
            <%= form_with model: todo, class: "flex min-w-0 flex-1 items-center gap-3" do |f| %>
              <%= f.check_box :done,
                    class: "h-4 w-4 shrink-0 cursor-pointer accent-indigo-600",
                    onchange: "this.form.requestSubmit()" %>
              <%= f.label :done,
                    class: class_names("min-w-0 flex-1 cursor-pointer text-sm break-words",
                                       "text-slate-400 line-through": todo.done?,
                                       "text-slate-800": !todo.done?) do %>
                <%= todo.title %>
              <% end %>
            <% end %>
            <%= button_to todo_path(todo), method: :delete,
                  form: { class: "shrink-0" },
                  class: "cursor-pointer rounded-md px-2 py-1 text-sm text-slate-400 hover:bg-slate-100 hover:text-slate-600",
                  title: "Delete",
                  aria: { label: "Delete #{todo.title}" } do %>
              &times;
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <section data-controller="sticky" aria-label="Sticky notes">
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="text-lg font-semibold">Sticky notes</h2>
      <span class="text-xs text-slate-400">Saved on this device</span>
    </div>
    <div class="flex flex-wrap gap-4">
      <% 3.times do |i| %>
        <%= tag.textarea placeholder: "Jot it here…", rows: 5,
              class: "sticky-note sticky-#{i + 1} min-w-0 flex-1 basis-40",
              data: { sticky_target: "note", index: i, action: "input->sticky#save" } %>
      <% end %>
    </div>
  </section>
</div>
