<% content_for(:title, "Customizations") %>

<h1 class="mb-2 text-2xl font-bold">Customizations</h1>
<p class="mb-6 text-sm text-slate-500">Pick a predefined mode. Saved on this device.</p>

<div data-controller="theme" class="grid grid-cols-2 gap-4 sm:grid-cols-3">
  <% [
    ["system", "System", "Follows your OS setting"],
    ["light",  "Light",  "Bright and clean"],
    ["dark",   "Dark",   "Easy on the eyes at night"],
    ["focus",  "Focus",  "Warm paper tone, no glare"],
    ["vibrant", "Vibrant", "Bold rose accents"]
  ].each do |preset, name, description| %>
    <button type="button"
            data-action="theme#select"
            data-preset="<%= preset %>"
            data-theme-target="option"
            class="rounded-xl border border-slate-200 bg-white p-4 text-left shadow-sm hover:border-indigo-300">
      <div class="mb-1 flex items-center justify-between">
        <span class="font-semibold"><%= name %></span>
        <span data-check class="hidden text-indigo-600">&#10003;</span>
      </div>
      <span class="text-sm text-slate-500"><%= description %></span>
    </button>
  <% end %>
</div>
