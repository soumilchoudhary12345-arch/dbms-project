<!DOCTYPE html>
<html>
  <head>
    <title>Sign in · Study</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function () {
        var preset = localStorage.getItem("study-theme") || "system";
        var resolved = preset === "system"
          ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : preset;
        document.documentElement.dataset.theme = resolved;
      })();
    </script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen items-center justify-center bg-slate-50 text-slate-900">
    <main class="w-full max-w-sm px-6">
      <%= yield %>
    </main>
  </body>
</html>
