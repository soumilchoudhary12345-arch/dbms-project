<!DOCTYPE html>
<html>
  <head>
    <title>Sign in · Study</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function () {
        var sync = localStorage.getItem("study-sync");
        var preset = localStorage.getItem("study-theme") || "light";
        if (preset === "system") { sync = "1"; preset = "light"; }
        if (sync === null) sync = "1";
        var resolved = sync !== "0"
          ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : preset;
        document.documentElement.dataset.theme = resolved;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400..700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen items-center justify-center bg-slate-50 text-slate-900">
    <main class="w-full max-w-sm px-6">
      <%= yield %>
    </main>
  </body>
</html>
