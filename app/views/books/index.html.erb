<% content_for(:title, "Textbook") %>

<h1 class="mb-6 text-2xl font-bold">Textbook</h1>

<% if @subjects.empty? %>
  <p class="rounded-lg border border-dashed border-slate-300 p-8 text-center text-slate-500">
    No books found. Set <code class="font-mono text-sm">STUDY_CONTENT_ROOT</code>
    or drop PDFs into the content folder.
  </p>
<% else %>
  <div class="flex flex-col gap-4">
    <% @subjects.each do |subject| %>
      <%= link_to book_subject_path(subject.slug),
            class: "group flex h-24 items-center justify-between rounded-xl bg-indigo-600 px-6 text-white shadow-sm transition hover:bg-indigo-700" do %>
        <span class="text-2xl font-semibold"><%= subject.name %></span>
        <span class="text-sm opacity-80 group-hover:opacity-100">
          <%= subject.chapters.size %> chapters
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @recommended.any? %>
  <h2 class="mb-1 mt-10 text-lg font-semibold">Recommended for you</h2>
  <p class="mb-4 text-sm text-slate-500">Based on what you have been practising lately.</p>

  <div class="grid gap-4 sm:grid-cols-2">
    <% @recommended.each do |book| %>
      <div class="flex flex-col rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <div class="mb-1 flex items-start justify-between gap-2">
          <span class="font-semibold text-slate-800"><%= book["title"] %></span>
          <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= book["type"] == "textbook" ? "bg-indigo-50 text-indigo-700" : "bg-amber-50 text-amber-700" %>">
            <%= book["type"] %>
          </span>
        </div>
        <p class="mb-3 flex-1 text-sm text-slate-500"><%= book["why"] %></p>
        <%= link_to "Buy", book["buy"],
              target: "_blank", rel: "noopener",
              class: "inline-flex justify-center rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-indigo-600 hover:border-indigo-300 hover:bg-indigo-50" %>
      </div>
    <% end %>
  </div>
<% end %>
