<% content_for(:title, "Result") %>

<% wrong = @attempts.select { |a| !a.correct && a.answer.present? } %>
<% blank = @attempts.select(&:skipped?) %>
<% right = @attempts.select(&:correct) %>
<% accuracy = @attempts.any? ? right.size.to_f / @attempts.size : 0 %>

<h1 class="mb-1 text-2xl font-bold">Session result</h1>
<p class="mb-6 text-sm text-slate-500">
  Scored <span class="font-semibold text-slate-800"><%= right.size %>/<%= @attempts.size %></span>
  · accuracy <%= (accuracy * 100).round %>%
</p>

<div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="text-sm text-slate-500">Correct</div>
    <div class="text-2xl font-bold text-emerald-600"><%= right.size %></div>
  </div>
  <div class="rounded-lg border border-rose-200 bg-white p-4">
    <div class="text-sm text-slate-500">Wrong</div>
    <div class="text-2xl font-bold text-rose-600"><%= wrong.size %></div>
  </div>
  <div class="rounded-lg border border-amber-200 bg-white p-4">
    <div class="text-sm text-slate-500">Left blank</div>
    <div class="text-2xl font-bold text-amber-600"><%= blank.size %></div>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="text-sm text-slate-500">Question mix</div>
    <div class="text-base font-semibold leading-snug"><%= @session.mix_label %></div>
  </div>
</div>

<% if wrong.empty? && blank.empty? && right.any? %>
  <div class="mb-8 rounded-lg border border-emerald-300 bg-emerald-50 p-5 text-sm font-medium text-emerald-800">
    Perfect run — every question correct.
  </div>
<% end %>

<% if wrong.any? %>
  <section class="mb-6 rounded-lg border border-rose-200 border-l-4 border-l-rose-500 p-5"
           aria-labelledby="wrong-heading">
    <h2 id="wrong-heading" class="mb-4 text-lg font-semibold text-rose-700">
      Wrong answers <span class="text-sm font-normal text-slate-500">(<%= wrong.size %>)</span>
    </h2>
    <div class="flex flex-col gap-4">
      <%= render partial: "sessions/review_card", collection: wrong, as: :attempt,
                 locals: { tone: :wrong } %>
    </div>
  </section>
<% end %>

<% if blank.any? %>
  <section class="mb-6 rounded-lg border border-amber-200 border-l-4 border-l-amber-500 p-5"
           aria-labelledby="blank-heading">
    <h2 id="blank-heading" class="mb-4 text-lg font-semibold text-amber-700">
      Left blank <span class="text-sm font-normal text-slate-500">(<%= blank.size %>)</span>
    </h2>
    <div class="flex flex-col gap-4">
      <%= render partial: "sessions/review_card", collection: blank, as: :attempt,
                 locals: { tone: :blank } %>
    </div>
  </section>
<% end %>

<% if right.any? %>
  <details class="mb-6 rounded-lg border border-emerald-200 bg-white p-5">
    <summary class="cursor-pointer text-lg font-semibold text-emerald-700">
      Correct answers <span class="text-sm font-normal text-slate-500">(<%= right.size %>)</span>
    </summary>
    <div class="mt-4 flex flex-col gap-4">
      <%= render partial: "sessions/review_card", collection: right, as: :attempt,
                 locals: { tone: :correct } %>
    </div>
  </details>
<% end %>

<%= button_to "Start another practice", quiz_sessions_path,
      method: :post,
      class: "mt-4 rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700" %>
