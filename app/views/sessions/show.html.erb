<% content_for(:title, "Practice") %>

<div data-controller="timer"
     data-timer-seconds-value="<%= @session.time_remaining %>"
     class="mb-6 flex items-center justify-between rounded-lg border border-slate-200 bg-white px-5 py-3">
  <span class="text-sm font-medium text-slate-600">Answer everything. No solutions until you submit.</span>
  <span data-timer-target="clock"
        class="font-mono text-2xl font-bold tabular-nums text-indigo-600">--:--</span>
</div>

<%= form_with url: submit_session_path(@session),
              method: :post,
              data: { timer_target: "form" } do %>
  <div class="flex flex-col gap-4">
    <% @session.question_attempts.includes(:question).each_with_index do |attempt, i| %>
      <% q = attempt.question %>
      <fieldset class="min-w-0 overflow-hidden rounded-lg border border-slate-200 bg-white p-5">
        <legend class="px-1 text-sm font-semibold text-indigo-600">Question <%= i + 1 %> · <%= q.difficulty.humanize %></legend>
        <p class="mb-3 min-w-0 break-words whitespace-pre-line text-slate-800"><%= q.body %></p>
        <div class="flex flex-col gap-2">
          <% q.options_hash.sort.each do |letter, text| %>
            <label class="flex min-w-0 cursor-pointer items-start gap-3 rounded-md border border-slate-200 px-3 py-2 hover:bg-slate-50">
              <%= radio_button_tag "answers[#{q.id}]", letter, false, class: "mt-1 shrink-0 accent-indigo-600" %>
              <span class="min-w-0 break-words"><span class="font-semibold"><%= letter %>.</span> <%= text %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
  </div>

  <div class="mt-6 flex justify-end">
    <%= submit_tag "Submit session",
          class: "cursor-pointer rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700",
          data: { timer_target: "submit" } %>
  </div>
<% end %>
