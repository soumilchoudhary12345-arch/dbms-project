<% content_for(:title, "Questions") %>

<h1 class="mb-2 text-2xl font-bold">Questions</h1>
<p class="mb-6 text-sm text-slate-500">
  Timed practice, picked for your level. Solutions and stats appear only after you submit.
</p>

<%= button_to "Start timed practice", quiz_sessions_path,
      method: :post,
      class: "rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-indigo-700" %>

<% finished = QuizSession.where(user: current_user, status: "finished").order(submitted_at: :desc).limit(10) %>
<% if finished.any? %>
  <h2 class="mb-3 mt-10 text-lg font-semibold">Your sessions</h2>
  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-slate-500">
        <tr>
          <th class="px-4 py-2 font-medium">When</th>
          <th class="px-4 py-2 font-medium">Score</th>
          <th class="px-4 py-2 font-medium">Mix</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% finished.each do |s| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-2"><%= s.submitted_at&.strftime("%b %d, %H:%M") %></td>
            <td class="px-4 py-2 font-medium"><%= s.correct_count %>/10</td>
            <td class="px-4 py-2 text-slate-500"><%= s.difficulty_mix %></td>
            <td class="px-4 py-2 text-right">
              <%= link_to "Review", result_session_path(s), class: "text-indigo-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
